---
import Layout from '../../layouts/Layout.astro';
import SiteNav from '../../components/SiteNav.astro';
import { products } from '../../data/products';

export function getStaticPaths() {
	return products.map((p) => ({
		params: { id: p.id },
		props: { product: p },
	}));
}

const { product } = Astro.props;

// magazine: statt "one size" die ausgabe bestaetigen ("issue 07")
const isMagazine = product.title.startsWith('MAG');
const issueLabel = product.title.replace('MAG ', '').toLowerCase();

const overlayTitle = product.sizes ? 'choose size' : isMagazine ? 'grab a copy' : 'add to cart';
const overlayOptions = product.sizes ?? [isMagazine ? issueLabel : 'one size'];
---

<Layout title={product.title}>
	<section class="product-page">
		<div class="product-details">
			<div class="details">
				<span class="id">{product.id}</span>
				<span class="title">{product.title}</span>
				<span class="price">€ {product.price}</span>
			</div>
		</div>
		<div class="product-images">
			{product.images.map((img) => (
				<img src={img.src} alt={img.alt} />
			))}
		</div>

		<a class="go-back" href="/collection">go back</a>

		<div class="size-overlay" id="size-overlay" data-id={product.id}>
			<span class="size-overlay-title">{overlayTitle}</span>
			<div class="size-overlay-options">
			{overlayOptions.map((o) => (
				<button class="size-overlay-option" data-size={product.sizes ? o : undefined}>{o}</button>
			))}
			</div>
			<button class="size-overlay-option size-overlay-cancel" data-cancel>nevermind</button>
		</div>
	</section>
	<SiteNav variant="products">
        <Fragment slot="buttons">
            <div class="product-buttons">
                <div class="nav-button" data-panel="description">
                    <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><path d="M32,64a8,8,0,0,1,8-8H216a8,8,0,0,1,0,16H40A8,8,0,0,1,32,64Zm8,48H168a8,8,0,0,0,0-16H40a8,8,0,0,0,0,16Zm176,24H40a8,8,0,0,0,0,16H216a8,8,0,0,0,0-16Zm-48,40H40a8,8,0,0,0,0,16H168a8,8,0,0,0,0-16Z"></path></svg>
                    <span class="nav-label">description</span>
                </div>
            </div>
            <div class="product-buttons">
                <div class="nav-button" data-panel="details">
                    <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><path d="M214.86,180.12a8,8,0,0,1-11,2.74L136,142.13V216a8,8,0,0,1-16,0V142.13L52.12,182.86a8,8,0,1,1-8.23-13.72L112.45,128,43.89,86.86a8,8,0,1,1,8.23-13.72L120,113.87V40a8,8,0,0,1,16,0v73.87l67.88-40.73a8,8,0,1,1,8.23,13.72L143.55,128l68.56,41.14A8,8,0,0,1,214.86,180.12Z"></path></svg>
                    <span class="nav-label">details</span>
                </div>
            </div>
            <div class="product-buttons">
                <div class="nav-button" data-panel="care">
                    <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><path d="M178,40c-20.65,0-38.73,8.88-50,23.89C116.73,48.88,98.65,40,78,40a62.07,62.07,0,0,0-62,62c0,70,103.79,126.66,108.21,129a8,8,0,0,0,7.58,0C136.21,228.66,240,172,240,102A62.07,62.07,0,0,0,178,40ZM128,214.8C109.74,204.16,32,155.69,32,102A46.06,46.06,0,0,1,78,56c19.45,0,35.78,10.36,42.6,27a8,8,0,0,0,14.8,0c6.82-16.67,23.15-27,42.6-27a46.06,46.06,0,0,1,46,46C224,155.61,146.24,204.15,128,214.8Z"></path></svg>
                    <span class="nav-label">care</span>
                </div>
            </div>
            <div class="product-buttons">
                <div class="nav-button" data-panel="size">
                    <svg class="nav-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 256"><path d="M192,96c0,28.51-24.47,52.11-56,55.56V160a8,8,0,0,1-16,0V144a8,8,0,0,1,8-8c26.47,0,48-17.94,48-40s-21.53-40-48-40S80,73.94,80,96a8,8,0,0,1-16,0c0-30.88,28.71-56,64-56S192,65.12,192,96Zm-64,96a16,16,0,1,0,16,16A16,16,0,0,0,128,192Z"></path></svg>
                    <span class="nav-label">size guide</span>
                </div>
            </div>
        </Fragment>
        <Fragment slot="panels">
            <div class="panel-section" data-panel="description">
                <span class="panel-eyebrow"><span>description</span><span>{product.title}</span></span>
                <p class="panel-text">{product.description}</p>
            </div>
            <div class="panel-section" data-panel="details">
                <span class="panel-eyebrow"><span>details</span><span>{product.title}</span></span>
                <p class="panel-text">{product.productDetails}</p>
            </div>
            <div class="panel-section" data-panel="care">
                <span class="panel-eyebrow"><span>care</span><span>{product.title}</span></span>
                <p class="panel-text">{product.productCare}</p>
            </div>
            <div class="panel-section" data-panel="size">
                <span class="panel-eyebrow"><span>size guide</span><span>{product.title}</span></span>
                {product.sizeGuide?.columns && (
                    <div class="size-row size-head">
                        {product.sizeGuide.columns.map((col) => (<span>{col}</span>))}
                    </div>
                )}
                {product.sizeGuide?.rows?.map((row) => (
                    <div class="size-row">
                        {row.map((cell) => (<span>{cell}</span>))}
                    </div>
                ))}
                {product.sizeGuide?.note && (
                    <p class="panel-text size-note">{product.sizeGuide.note}</p>
                )}
            </div>
        </Fragment>
    </SiteNav>
</Layout>

<script>
	import { addToCart, initCartUI } from '../../scripts/cart';
	import { products } from '../../data/products';
	import { initNav } from '../../scripts/nav';

	// vertikales mausrad auf horizontales scrollen der bilder mappen
	// (nur desktop; mobile scrollt die bilder vertikal)
	const imagesEl = document.querySelector<HTMLElement>('.product-images')!;
	const isMobile = window.matchMedia('(max-width: 599px)');
	imagesEl.addEventListener('wheel', (e) => {
		if (isMobile.matches || e.deltaY === 0) return;
		e.preventDefault();
		imagesEl.scrollLeft += e.deltaY;
	}, { passive: false });

	const dotMeta = document.getElementById('dot-meta');
	const dot = document.querySelector('.cursor-dot');

	imagesEl.querySelectorAll('img').forEach((img) => {
		img.addEventListener('mouseenter', () => {
			if (dotMeta) dotMeta.textContent = 'add to cart';
			dot?.classList.add('active');
		});

		img.addEventListener('mouseleave', () => {
			if (dotMeta) dotMeta.textContent = '';
			dot?.classList.remove('active');
		});

		img.addEventListener('click', (e) => {
			// bild-klick oeffnet das size-overlay am cursor
			if (!sizeOverlay) return;
			sizeOverlay.style.left = e.clientX + 'px';
			sizeOverlay.style.top = e.clientY + 'px';
			sizeOverlay.classList.add('open');
		});
	});

	// size-overlay: groesse waehlen legt in den cart, nevermind schliesst
	const sizeOverlay = document.getElementById('size-overlay');
	sizeOverlay?.addEventListener('click', (e) => {
		const option = (e.target as HTMLElement).closest<HTMLElement>('.size-overlay-option');
		if (!option) return;

		if (option.dataset.cancel !== undefined) {
			sizeOverlay.classList.remove('open');
			return;
		}

		addToCart(sizeOverlay.dataset.id!, option.dataset.size);
		sizeOverlay.classList.remove('open');
	});

	// nav-panels (menu / description / details / care / size / cart)
	const navWrapper = document.querySelector<HTMLElement>('.nav-products')!;
	const cartBtn = navWrapper.querySelector<HTMLElement>('.cart-expand-button')!;

	const navPairs = [{ el: navWrapper.querySelector<HTMLElement>('.main-icon')!, panel: 'main' }];
	navWrapper.querySelectorAll<HTMLElement>('.product-buttons .nav-button').forEach((el) => {
		navPairs.push({ el, panel: el.dataset.panel! });
	});
	navPairs.push({ el: cartBtn, panel: 'cart' });

	initNav(navWrapper, navPairs);

	initCartUI(
		navWrapper.querySelector<HTMLElement>('[data-panel="cart"]')!,
		cartBtn,
		products,
	);

	// füge dem dot die click klasse hinzu
    window.addEventListener('click', () => {
        dot?.classList.add('click');
        setTimeout(() => dot?.classList.remove('click'), 400);
    });
</script>