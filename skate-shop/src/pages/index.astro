---
import Layout from '../layouts/Layout.astro';

const editorials = [
	'/landingpage/editiorial_strafe_1.webp',
	'/landingpage/editiorial_strafe_2.webp',
	'/landingpage/editiorial_strafe_3.webp',
	'/landingpage/editiorial_strafe_4.webp',
	'/landingpage/editiorial_strafe_5.webp',
	'/landingpage/editiorial_strafe_6.webp',
];

const chosen = [
	{ closeUp: '/landingpage/close_up1.webp', product: '/landingpage/product1.webp', title:'DECK STAR BB', price:'120', id: 'IDNR12', description: 'Seven-ply maple deck with the Star graphic in black on blue. Medium concave, steep kicks, a shape that works for street and park alike.' },
	{ closeUp: '/landingpage/close_up2.webp', product: '/landingpage/product2.webp', title:'JEANS BAGGY ASPHALT', price:'120', id: 'IDNR19', description: 'Baggy five-pocket jeans in asphalt grey. Wide through the leg from hip to hem with a low rise and plenty of room to move.' },
	{ closeUp: '/landingpage/close_up3.webp', product: '/landingpage/product3.webp', title:'SHIRT DRK BW', price:'120', id: 'IDNR24', description: 'Striped cotton shirt in black and white with an oversized graphic print across the chest. Boxy fit, worn open over a tee or buttoned all the way.' },
	{ closeUp: '/landingpage/close_up4.webp', product: '/landingpage/product4.webp', title:'SWEATER STR RED', price:'120', id: 'IDNR3', description: 'Heavyweight zip hoodie in deep red. Boxy cut with dropped shoulders, a deep hood and a full-length metal zip. Built for cold sessions and everything after.' },
	{ closeUp: '/landingpage/close_up5.webp', product: '/landingpage/product5.webp', title:'BEANIE STAR BEIGE', price:'120', id: 'IDNR21', description: 'Ribbed beanie in beige with an embroidered Star patch on the cuff. Long enough to fold once or wear slouched.' },
	{ closeUp: '/landingpage/close_up6.webp', product: '/landingpage/product6.webp', title:'COW BELT', price:'120', id: 'IDNR6', description: 'Leather belt in a black and white cow pattern with a brushed metal buckle. A plain pair of jeans is all it needs.' },
];
---

<Layout title="strafe.shop">
	<div class="loader" id="loader">
		<div class="loader-stack">
			{editorials.map((src, i) => (
				<img src={src} alt="" decoding="async" style={`--rot: ${(i - 2.5) * 4}deg; animation-delay: ${(i * 0.25).toFixed(2)}s`} />
			))}
		</div>
	</div>
	<section class="editorial-loop">
		<div class="editorial-viewport">
			<div class="editorial-track">
				{[...editorials, ...editorials].map((src) => (
					<img src={src} alt="" decoding="async" />
				))}
			</div>
		</div>
		<div class="options">
			<div class="ediorial-track-options">
				<div class="ediorial-track-options-pause--resume">PAUSE</div>
				<div class="ediorial-track-options-faster">FASTER</div>
				<div class="ediorial-track-options-slower">SLOWER</div>
			</div>
		</div>
	</section>
	<section class="link-site" id="link-site"></section>
	<div class="chosen-products">
		{chosen.map((c) => (
			<div class="chosen-product">
				<a href=`/products/${c.id}`><img class="product-close" src={c.closeUp} alt="" decoding="async" /></a>
			</div>
			<div class="product-info">
				<img class="product-full" src={c.product} alt="" decoding="async" />
				<span class="title">{c.title}</span>
				<span class="desc">{c.description}</span>
			</div>
		))}
	</div>
	<div class="nav-start">
		<div class="meta">
			<span id="date"></span>
			<span id="time"></span>
			<span>BRL</span>
		</div>
	</div>
	<div class="links">
		<span>strafe.site</span>
		<a href="/collection">enter collection</a>
	</div>
</Layout>

<script>
	import { navigate } from 'astro:transitions/client';

	// overlay, lade bildschirm
	const loader = document.getElementById('loader');
	if (loader) {
		const bilder = loader.querySelectorAll('img').length;
		const dauer = (bilder - 1) * 250 + 500;
		setTimeout(() => loader.classList.add('done'), dauer + 500);
		setTimeout(() => loader.remove(), dauer + 500 + 400);
	}

	const dot = document.querySelector('.cursor-dot');
	const dotMeta = document.getElementById('dot-meta');

	const track = document.querySelector('.editorial-track')!;

	// die scroll-animation vom track holen (nicht die transitions)
	function getAnim() {
		const anims = track.getAnimations() as CSSAnimation[];
		return anims.find(a => a.animationName === 'editorial-scroll');
	}

	// der Track enthaelt die Bilder doppelt
	const count = track.children.length / 2;

	let paused = false;

	document.querySelectorAll('.chosen-product').forEach((el, i) => {
		el.addEventListener('mouseenter', () => {
			const anim = getAnim();
			if (!anim) return;
			anim.pause();
			anim.currentTime = (i % count) / count * Number(anim.effect!.getTiming().duration);
		});

		el.addEventListener('mouseleave', () => { if (!paused) getAnim()?.play(); });
	});

	// editorial track optionen pause + weiter
	const pauseBtn = document.querySelector('.ediorial-track-options-pause--resume')!;
	pauseBtn.addEventListener('click', () => {
		const anim = getAnim();
		if (!anim) return;
		paused = !paused;
		if (paused) anim.pause();
		else anim.play();
		pauseBtn.textContent = paused ? 'RESUME' : 'PAUSE';
	});

	document.querySelector('.ediorial-track-options-faster')!.addEventListener('click', () => {
		const anim = getAnim();
		if (anim) anim.playbackRate *= 1.5;
	});

	document.querySelector('.ediorial-track-options-slower')!.addEventListener('click', () => {
		const anim = getAnim();
		if (anim) anim.playbackRate /= 1.5;
	});

	// datum, zeit 
	const dateEl = document.getElementById('date')!;
	const timeEl = document.getElementById('time')!;

	const tick = () => {
		const now = new Date();
		dateEl.textContent = now.toLocaleDateString('de-DE', { timeZone: 'Europe/Berlin' });
		timeEl.textContent = now.toLocaleTimeString('de-DE', { timeZone: 'Europe/Berlin' });
	};

	tick();
	setInterval(tick, 1000);

	// füge dem dot die click klasse hinzu
    window.addEventListener('click', () => {
        dot?.classList.add('click');
        setTimeout(() => dot?.classList.remove('click'), 400);
    });

	// link zu collection im unteren Bereich der Seite
	const linkCollection = document.getElementById('link-site');

	linkCollection?.addEventListener('mouseenter', () => {
		if (dotMeta) dotMeta.textContent = 'enter collection';
		dot?.classList.add('active');
	});

	linkCollection?.addEventListener('mouseleave', () => {
		if (dotMeta) dotMeta.textContent = '';
		dot?.classList.remove('active');
	});

	linkCollection?.addEventListener('click', () => {
		navigate('/collection');
	});
</script>
