---
import '../styles/global.scss';
import '../styles/reset.css';
const { title = 'strafe.shop' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg" sizes="32x32" href="/favicon/favicon.svg">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="cursor" id="cursor" aria-hidden="true">
			<div class="cursor-dot">
				<div class="dot-meta" id="dot-meta"></div>
			</div>
		</div>
		<div class="help" id="help">
			<button class="help-toggle" aria-label="about this test"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#000000" viewBox="0 0 256 256"><path d="M192,96c0,28.51-24.47,52.11-56,55.56V160a8,8,0,0,1-16,0V144a8,8,0,0,1,8-8c26.47,0,48-17.94,48-40s-21.53-40-48-40S80,73.94,80,96a8,8,0,0,1-16,0c0-30.88,28.71-56,64-56S192,65.12,192,96Zm-64,96a16,16,0,1,0,16,16A16,16,0,0,0,128,192Z"></path></svg></button>
			<div class="help-tip">
				Schau dich in Ruhe <u>etwas genauer um</u>, öffne Produkte und stöbere durch die Seite.<br><br>
				Sprich dabei <u>laut aus</u>, was dir durch den Kopf geht – was dir gefällt, was dich stört, was dich verwirrt.<br><br>
				Zur Erinnerung lege <u>mindestens 5 Artikel in den Warenkorb</u>.
			</div>
		</div>
		<div class="random-color" id="random-color">
			<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#000000" viewBox="0 0 256 256"><path d="M48,64a8,8,0,0,1,8-8H72V40a8,8,0,0,1,16,0V56h16a8,8,0,0,1,0,16H88V88a8,8,0,0,1-16,0V72H56A8,8,0,0,1,48,64ZM184,192h-8v-8a8,8,0,0,0-16,0v8h-8a8,8,0,0,0,0,16h8v8a8,8,0,0,0,16,0v-8h8a8,8,0,0,0,0-16Zm56-48H224V128a8,8,0,0,0-16,0v16H192a8,8,0,0,0,0,16h16v16a8,8,0,0,0,16,0V160h16a8,8,0,0,0,0-16ZM219.31,80,80,219.31a16,16,0,0,1-22.62,0L36.68,198.63a16,16,0,0,1,0-22.63L176,36.69a16,16,0,0,1,22.63,0l20.68,20.68A16,16,0,0,1,219.31,80Zm-54.63,32L144,91.31l-96,96L68.68,208ZM208,68.69,187.31,48l-32,32L176,100.69Z"></path></svg>
		</div>

		<slot />

		<script>
			import Clarity from '@microsoft/clarity';

			const cursor = document.getElementById('cursor');

			window.addEventListener('mousemove', (e) => {
				cursor.style.setProperty('--cursor-x', e.clientX + 'px');
				cursor.style.setProperty('--cursor-y', e.clientY + 'px');
			});

			const randomColor = document.getElementById('random-color');
			const COLOR_KEY = 'random-color';

			const savedColor = localStorage.getItem(COLOR_KEY);
			let colored = !!savedColor;
			if (savedColor) {
				document.documentElement.style.setProperty('--currentcolor', savedColor);
				randomColor?.classList.add('colored');
			}

			randomColor?.addEventListener('click', () => {
				colored = !colored;
				if (colored) {
					const dunkel = () => Math.floor(Math.random() * 128).toString(16).padStart(2, '0');
					const farbe = '#' + dunkel() + dunkel() + dunkel();
					localStorage.setItem(COLOR_KEY, farbe);
					document.documentElement.style.setProperty('--currentcolor', farbe);
				} else {
					localStorage.removeItem(COLOR_KEY);
					document.documentElement.style.setProperty('--currentcolor', 'var(--black)');
				}
				randomColor!.classList.toggle('colored', colored);
			});

			// einwilligung key clarity
			const CONSENT_KEY = 'cookie-consent';

			if (import.meta.env.PROD) {
				Clarity.init('xx3ugmyhk1');
				if (localStorage.getItem(CONSENT_KEY) === 'granted') {
					Clarity.consentV2({ ad_Storage: 'denied', analytics_Storage: 'granted' });
				}
			}
		</script>
	</body>
</html>


