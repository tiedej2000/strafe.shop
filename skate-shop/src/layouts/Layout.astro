---
import '../styles/global.scss';
import '../styles/reset.css';
const { title = 'strafe.shop' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg" sizes="32x32" href="/favicon/favicon.svg">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="cursor" id="cursor" aria-hidden="true">
			<div class="cursor-dot">
				<div class="dot-meta" id="dot-meta"></div>
			</div>
		</div>
		<div class="help" id="help">
			<button class="help-toggle" aria-label="about this test"><svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#000000" viewBox="0 0 256 256"><path d="M192,96c0,28.51-24.47,52.11-56,55.56V160a8,8,0,0,1-16,0V144a8,8,0,0,1,8-8c26.47,0,48-17.94,48-40s-21.53-40-48-40S80,73.94,80,96a8,8,0,0,1-16,0c0-30.88,28.71-56,64-56S192,65.12,192,96Zm-64,96a16,16,0,1,0,16,16A16,16,0,0,0,128,192Z"></path></svg></button>
			<div class="help-tip">
				Schau dich in Ruhe <u>etwas genauer um</u>, öffne Produkte und stöbere durch die Seite.<br><br>
				Sprich dabei <u>laut aus</u>, was dir durch den Kopf geht – was dir gefällt, was dich stört, was dich verwirrt.<br><br>
				Zur Erinnerung lege <u>mindestens 5 Artikel in den Warenkorb</u>.
			</div>
		</div>

		<slot />

		<script>
			import Clarity from '@microsoft/clarity';

			const cursor = document.getElementById('cursor');

			window.addEventListener('mousemove', (e) => {
				cursor.style.setProperty('--cursor-x', e.clientX + 'px');
				cursor.style.setProperty('--cursor-y', e.clientY + 'px');
			});

			if (import.meta.env.PROD) {
   			 Clarity.init("xx3ugmyhk1");
			}

		</script>
	</body>
</html>


