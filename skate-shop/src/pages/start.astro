---
import Layout from '../layouts/Layout.astro';
---

<Layout title="strafe.shop">
    <section class="start">
        <div class="card" id="main-card">
            <div class="top">
                <span class="badge" id="badge"></span>
                <span class="step" id="step"></span>
            </div>

            <h1 class="title" id="title"></h1>
            <p class="desc" id="description"></p>

            <div class="context" id="context"></div>

            <div class="foot">
                <button class="btn" id="prev-btn">
                    <svg class="svg-prev" xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#000000" viewBox="0 0 256 256"><path d="M165.66,202.34a8,8,0,0,1-11.32,11.32l-80-80a8,8,0,0,1,0-11.32l80-80a8,8,0,0,1,11.32,11.32L91.31,128Z"></path></svg>
                    <span id="prev-label"></span>
                </button>

                <div class="dots" id="dots"></div>

                <button class="btn" id="next-btn">
                    <span id="next-label"></span>
                    <svg class="svg-next" xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="#000000" viewBox="0 0 256 256"><path d="M181.66,133.66l-80,80a8,8,0,0,1-11.32-11.32L164.69,128,90.34,53.66a8,8,0,0,1,11.32-11.32l80,80A8,8,0,0,1,181.66,133.66Z"></path></svg>
                </button>
            </div>
        </div>
    </section>
</Layout>

<script>
    const slides = [
        {
            title: "Willkommen",
            description: "Schön, dass du dabei bist. Du schaust dir gleich einen Online-Shop an, den ich für ein Studienprojekt gebaut habe. Vorab ein paar kurze Hinweise, dann geht’s los.",
            contextType: "none",
            nextLabel: "Weiter",
        },
        {
            title: "Denk laut mit",
            description: "Das Wichtigste zuerst: Schau dich in Ruhe <u>genau um</u> und probier <u>so viel wie möglich</u> aus. Klick dich durch, öffne Produkte, teste die Seite. <u>Sprich dabei laut aus, was dir durch den Kopf geht</u> – was dir auffällt, wo du zögerst, was dir gefällt oder fehlt. Es gibt kein richtig oder falsch.",
            contextType: "none",
            nextLabel: "Weiter",
        },
        {
            title: "Deine Aufgabe",
            description: "Stell dir vor, du stellst dir ein komplettes Outfit für die neue Saison zusammen. Stöber durch den Shop und leg dir <u>mindestens fünf Artikel in den Warenkorb</u> – welche das sind, ist ganz dir überlassen. Am Ende <u>schließt du den Kauf ab</u>.",
            contextType: "none",
            nextLabel: "Weiter",
        },
        {
            title: "Kurz noch",
            description: "Damit ich dein lautes Mitdenken später auswerten kann, wird die Sitzung <u>aufgezeichnet</u> – Bildschirm, Klicks und Ton. Das bleibt natürlich intern und wird <u>ausschließlich für diese Studie verwendet</u>. Bestätige unten kurz dein Einverständnis, dann geht’s los. :-)",
            contextType: "consent",
            nextLabel: "Zum Shop",
        }
    ];

    const CONSENT_KEY = 'cookie-consent';

    let currentStep = 0;

    const titleEl = document.getElementById("title")!;
    const descriptionEl = document.getElementById("description")!;
    const badgeEl = document.getElementById("badge")!;
    const stepEl = document.getElementById("step")!;
    const dotsContainer = document.getElementById("dots")!;
    const contextEl = document.getElementById("context")!;

    const prevLabel = document.getElementById("prev-label")!;
    const nextLabel = document.getElementById("next-label")!;
    const prevBtn = document.getElementById("prev-btn") as HTMLButtonElement;
    const nextBtn = document.getElementById("next-btn") as HTMLButtonElement;

    badgeEl.textContent = "GUIDE";

    // dots erzeugen
    for (let i = 0; i < slides.length; i++) {
        const dot = document.createElement("span");
        dot.classList.add("dot");
        dotsContainer.appendChild(dot);
    }

    // karte nach currentStep füllen
    function render() {
        const slide = slides[currentStep];

        titleEl.textContent = slide.title;
        descriptionEl.innerHTML = slide.description;

        const aktuell = String(currentStep + 1).padStart(2, "0");
        const gesamt = String(slides.length).padStart(2, "0");
        stepEl.textContent = `${aktuell} / ${gesamt}`;

        prevLabel.textContent = "Zurück";
        nextLabel.textContent = slide.nextLabel;

        // aktiven dot markieren
        const dots = dotsContainer.children;
        for (let i = 0; i < dots.length; i++) {
            dots[i].classList.toggle("on", i === currentStep);
        }

        // zurück am anfang sperren, weiter bleibt immer klickbar
        prevBtn.disabled = (currentStep === 0);

        // context füllen
        contextEl.innerHTML = "";
        nextBtn.disabled = false;

        if (slide.contextType === "list") {
            const ul = document.createElement("ul");
            ul.classList.add("list");

            for (let i = 0; i < slide.items!.length; i++) {
                const li = document.createElement("li");
                li.textContent = slide.items![i];
                ul.appendChild(li);
            }

            contextEl.appendChild(ul);
        }

        if (slide.contextType === "consent") {
            const label = document.createElement("label");
            label.classList.add("consent-step");

            const box = document.createElement("input");
            box.type = "checkbox";

            const text = document.createElement("span");
            text.textContent = "Ich bin mit der anonymen Aufzeichnung für diese Studie einverstanden.";

            label.appendChild(box);
            label.appendChild(text);
            contextEl.appendChild(label);

            // sobald angehakt: einwilligung merken und clarity direkt erlauben,
            // damit das cookie noch auf der start-seite gesetzt wird (bevor navigiert wird)
            box.checked = localStorage.getItem(CONSENT_KEY) === "granted";
            nextBtn.disabled = !box.checked;
            box.addEventListener("change", () => {
                nextBtn.disabled = !box.checked;
                if (box.checked) {
                    localStorage.setItem(CONSENT_KEY, "granted");
                    if (import.meta.env.PROD) {
                        (window as any).clarity?.("consentv2", { ad_Storage: "denied", analytics_Storage: "granted" });
                    }
                }
            });
        }
    }

    render();

    nextBtn.addEventListener('click', () => {
        if (currentStep < slides.length - 1) {
            currentStep++;
            render();
        } else {
            // einwilligung merken und clarity direkt erlauben
            localStorage.setItem(CONSENT_KEY, "granted");
            if (import.meta.env.PROD) {
                (window as any).clarity?.("consentv2", { ad_Storage: "denied", analytics_Storage: "granted" });
            }
            window.location.href = '/';
        }
    });

    prevBtn.addEventListener('click', () => {
        if (currentStep > 0) {
            currentStep--;
            render();
        }
    });
</script>
