---
import Layout from '../layouts/Layout.astro';
import { products } from '../data/products';
import Image from 'astro/components/Image.astro';

const path = Astro.url.pathname;

// produkt reihenfolge
const categoryOrder = [
	'tops',
	'bottoms',
	'accessories',
	'gear',
	'collectible',
];

// position einer kategorie in der reihenfolge; unbekannte ans ende
function categoryIndex(category: string) {
	const i = categoryOrder.indexOf(category);
	if (i === -1) return categoryOrder.length;
	return i;
}

const sortedProducts = [...products].sort((a, b) => {
	return categoryIndex(a.category) - categoryIndex(b.category);
});

// alle kategorien die es in den produkten gibt (ohne doppelte), plus "all"
const categories = ['all', ...new Set(sortedProducts.map((p) => p.category))];
---

<Layout title="collection">
    <section class="collection">
        <div class="collection-grid single" id="grid">
            {sortedProducts.map((p) => {
                const front = p.images.find((img) => img.type === 'front') ?? p.images[0];
                const modell = p.images.find((img) => img.type === 'modell');

                // hauptbild ist modell (worn) sonst front; die vorschau zeigt alles andere
                const main = modell ?? front;
                const shots = p.images.filter((img) => img !== main);
                return (
                <a href={`/products/${p.id}`} data-category={p.category}>
                    <article class="product-card">
                        <div class="product-card-info">
                            <span class="title">{p.title}</span>
                            <span class="price">€{p.price}</span>
                        </div>
                        <div class="product-img">
                            <img
                                src={modell?.src ?? front.src}
                                alt={modell?.alt ?? front.alt}
                                data-front={front.src}
                                data-modell={modell?.src}
                                loading="lazy"
                            />
                            {p.video && (
                                <video class="product-video" src={p.video} muted loop playsinline preload="metadata"></video>
                            )}
                            <div class="product-shots">
                                {shots.map((s) => (
                                    <img src={s.src} alt={s.alt} loading="lazy" />
                                ))}
                            </div>
                        </div>
                    </article>
                </a>
                );
            })}
        </div>
    </section>
    <div class="nav-collection">
        <div class="nav-main">
            <div class="main-icon">menu</div>
        </div>
        <div class="nav-grid">
            <div class="grid-buttons">
                <div class="nav-button active" id="single-btn">1row</div>
                <div class="nav-button" id="min-btn">3col</div>
                <div class="nav-button " id="mid-btn">4col</div>
                <div class="nav-button" id="max-btn">5col</div>
            </div>
            <div class="view-buttons">
                <div class="nav-button" id="product-view">flat</div>
                <div class="nav-button active" id="model-view">worn</div>
            </div>
            <div class="tag-buttons">
                <div class="nav-button" id="tag-off">no tags</div>
                <div class="nav-button active" id="tag-on">tags</div>
            </div>
            <div class="info">
                <div class="nav-button" id="nav-expand">filter</div>
            </div>
            <div class="nav-expanded" id="nav-panel">
                <div class="panel-section" data-panel="main">
                    <div class="nav-options">
                        <ul>
                            <li><a href="/" aria-current={path === '/' ? 'page' : undefined}>start</a></li>
                            <li><a href="/collection" aria-current={path === '/collection' ? 'page' : undefined}>collection</a></li>
                            <li><a href="/impressum" aria-current={path === '/impressum' ? 'page' : undefined}>impressum</a></li>
                            <li>other (coming soon)</li>
                        </ul>
                    <div class="logo"><?xml version="1.0" encoding="UTF-8"?>
                        <svg id="Ebene_2" data-name="Ebene 2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 804.33 804.35">
                        <g id="Ebene_2-2" data-name="Ebene 2">
                            <polygon points="625.69 512.41 453.37 485.02 404.59 656.54 352.69 507.01 181.63 609.37 289.23 450.3 124.71 406.42 310.78 357.6 276.68 200.53 401.11 298.71 523.12 146.72 492.21 317.98 678.44 285.53 515.46 400.9 625.69 512.41"/>
                            <path d="M803.58,377.35c-6.53-106.42-54.62-201.81-128.2-270.04-17.7-16.43-36.88-31.27-57.32-44.32-15.3-9.78-31.31-18.55-47.93-26.21C518.98,13.17,462.08,0,402.17,0,180.42,0,0,180.42,0,402.19s180.42,402.17,402.17,402.17c128.78,0,243.61-60.83,317.25-155.28h.02c38.79-49.74,66.14-108.8,78.13-173.2,4.44-23.89,6.77-48.53,6.77-73.68,0-8.33-.26-16.63-.75-24.84ZM599.95,708.19c-57,36.98-124.93,58.47-197.78,58.47-106.44,0-202.38-45.87-269.06-118.88-22.88-25.04-42.3-53.25-57.55-83.9-24.22-48.75-37.85-103.66-37.85-161.69,0-196.57,156.41-357.31,351.34-364.25,4.36-.16,8.73-.24,13.13-.24,18.41,0,36.5,1.37,54.2,4.03,17.24,2.58,34.1,6.37,50.47,11.29,37.62,11.29,72.71,28.53,104.16,50.61,11.31,7.92,22.16,16.49,32.48,25.61,54.7,48.43,94.79,113.03,112.73,186.21,6.82,27.8,10.44,56.86,10.44,86.74,0,9.7-.38,19.3-1.13,28.81-9.13,116.12-72.91,217.12-165.56,277.2Z"/>
                            <polygon points="625.57 512.96 453.26 485.57 404.48 657.08 352.58 507.55 181.52 609.91 289.12 450.84 124.6 406.97 310.67 358.14 276.57 201.08 401 299.26 523 147.27 492.09 318.53 678.32 286.07 515.35 401.45 625.57 512.96"/>
                        </g>
                        </svg>
                    </div>
                    </div>
                    <div class="titles"><span>strafe.site</span><span> made by JT</span></div>
                </div>
                <div class="panel-section" data-panel="grid">
                    <div class="category-filter">
                        {categories.map((c) => (
                            <button class={`filter-btn ${c === 'all' ? 'active' : ''}`} data-category={c}>{c}</button>
                        ))}
                    </div>
                </div>
                <div class="panel-section" data-panel="cart">
                    
                </div>
            </div>
        </div>
        <div class="cart-expand-button">cart</div>
    </div>
</Layout>

<script>
import { navigate } from "astro:transitions/client";
import { products } from '../data/products';
import { initCartUI } from '../scripts/cart';

    const grid = document.getElementById('grid')!;
    const gridBtns = document.querySelectorAll('.grid-buttons .nav-button');
    const viewBtns = document.querySelectorAll('.view-buttons .nav-button');
    const tagBtns = document.querySelectorAll('.tag-buttons .nav-button');

    //zuweisung active klassen im nav
    gridBtns.forEach((btn)=>{
        btn.addEventListener('click',() =>{
            gridBtns.forEach((b)=>{
                b.classList.remove('active')
            })
            btn.classList.add('active');
        })
    })

    viewBtns.forEach((btn)=>{
        btn.addEventListener('click',() =>{
            viewBtns.forEach((b)=>{
                b.classList.remove('active')
            })
            btn.classList.add('active');
        })
    })

    tagBtns.forEach((btn)=>{
        btn.addEventListener('click',() =>{
            tagBtns.forEach((b)=>{
                b.classList.remove('active')
            })
            btn.classList.add('active');
        })
    })


    // grid view änderung 
    document.getElementById('single-btn')!.addEventListener('click', () => {
	    localStorage.setItem('col-grid', 'single-btn');
	    // inline grid-styles der spalten-ansicht entfernen, damit safari den
	    // flex-container nicht mit resten der grid-ansicht neu berechnet
	    grid.style.gridTemplateColumns = '';
	    grid.classList.add('single');
	    window.scrollTo({ top: 0, behavior: 'instant' });
        grid.style.gap = '20px';
    });
    document.getElementById('min-btn')!.addEventListener('click', () => {
	    localStorage.setItem('col-grid', 'min-btn');
	    grid.classList.remove('single');
	    grid.style.gridTemplateColumns = 'repeat(3, 1fr)';
        grid.style.gap = '20px';    });
    document.getElementById('mid-btn')!.addEventListener('click', () => {
	    localStorage.setItem('col-grid', 'mid-btn');
	    grid.classList.remove('single');
	    grid.style.gridTemplateColumns = 'repeat(4, 1fr)';
        grid.style.gap = '10px';    });
    document.getElementById('max-btn')!.addEventListener('click', () => {
	    localStorage.setItem('col-grid', 'max-btn');
	    grid.classList.remove('single');
	    grid.style.gridTemplateColumns = 'repeat(5, 1fr)';
        grid.style.gap = '10px';    });

    // wenn single view, mappe vertical scroll auf horizontal
    grid.addEventListener('wheel', (e) => {
        if (!grid.classList.contains('single') || e.deltaY === 0) return;
        e.preventDefault();
        grid.scrollLeft += e.deltaY;
    }, { passive: false });

    
    const cardImages = document.querySelectorAll<HTMLImageElement>('.product-img > img');

    // aktuelle Ansicht
    let currentView: 'front' | 'modell' = 'modell';

    document.getElementById('product-view')!.addEventListener('click', () => {
        localStorage.setItem('col-view', 'product-view');
        currentView = 'front';
        cardImages.forEach((img) => { img.src = img.dataset.front!; });
    });

    document.getElementById('model-view')!.addEventListener('click', () => {
        localStorage.setItem('col-view', 'model-view');
        currentView = 'modell';
        cardImages.forEach((img) => {
            img.src = img.dataset.modell ?? img.dataset.front!;
        });
    });

    //product tags view
    const cardInfos = document.querySelectorAll('.product-card-info')

    document.getElementById('tag-off')!.addEventListener('click',()=>{
        localStorage.setItem('col-tags', 'tag-off');
        cardInfos.forEach((card)=>{
            card.classList.add('hidden')
        })
    })

    document.getElementById('tag-on')!.addEventListener('click',()=>{
        localStorage.setItem('col-tags', 'tag-on');
        cardInfos.forEach((card)=>{
            card.classList.remove('hidden')
        })
    });

    // gespeicherte nav-einstellungen wiederherstellen
    ['col-grid', 'col-view'].forEach((key) => {
        const id = localStorage.getItem(key);
        if (id) document.getElementById(id)?.click();
    });


    // beim hovern eines produktbilds den titel in die cursor-meta schreiben
    const dotMeta = document.getElementById('dot-meta');
    const dot = document.querySelector('.cursor-dot');

    document.querySelectorAll<HTMLElement>('.product-card').forEach((card) => {
        const img = card.querySelector<HTMLElement>('.product-img');
        const title = card.querySelector('.title')?.textContent ?? '';
        if (!img || !dotMeta) return;

        // falls die karte ein video hat: bei hover abspielen, sonst zuruecksetzen
        const video = card.querySelector<HTMLVideoElement>('.product-video');

        img.addEventListener('mouseenter', () => {
            dotMeta.textContent = title;
            dotMeta.classList.add('active');
            dot?.classList.add('active');
            video?.play();
        });
        img.addEventListener('mouseleave', () => {
            dotMeta.textContent = '';
            dotMeta.classList.remove('active');
            dot?.classList.remove('active');
            if (video) { video.pause(); video.currentTime = 0; }
        });
    });

    // füge dem dot die click klasse hinzu
    window.addEventListener('click', () => {
        dot?.classList.add('click');
        setTimeout(() => dot?.classList.remove('click'), 400);
    });


    // panel based on welches menü
    const navPanel = document.getElementById('nav-panel')!;

    function openPanel(name: string) {
        const section = navPanel.querySelector(`[data-panel="${name}"]`)!;
        const wasOpen = section.classList.contains('active');
        navPanel.querySelectorAll('.panel-section').forEach((s) => s.classList.remove('active'));
        navPanel.classList.toggle('active', !wasOpen);
        section.classList.toggle('active', !wasOpen);
    }

    const moreBtn = document.getElementById('nav-expand')!;
    moreBtn.addEventListener('click', () => {
        openPanel('grid');
        moreBtn.classList.toggle('active');
    });

    const menuBtn = document.querySelector('.main-icon')!;
    menuBtn.addEventListener('click', () => {
        openPanel('main');
        menuBtn.classList.toggle('active');
    });

    const cartBtn = document.querySelector('.cart-expand-button')!;
    cartBtn.addEventListener('click', () => {
        openPanel('cart');
        cartBtn.classList.toggle('active');
    });

    // beim verlassen der nav schliesst sich das offene panel automatisch
    document.querySelector<HTMLElement>('.nav-collection')!.addEventListener('mouseleave', () => {
        navPanel.classList.remove('active');
        navPanel.querySelectorAll('.panel-section').forEach((s) => s.classList.remove('active'));
        moreBtn.classList.remove('active');
        menuBtn.classList.remove('active');
        cartBtn.classList.remove('active');
    });

    // ---- cart panel (gemeinsames rendering aus cart.ts) ----
    initCartUI(
        navPanel.querySelector<HTMLElement>('[data-panel="cart"]')!,
        cartBtn as HTMLElement,
        products,
    );

    // filter + produkte anzeigen lassen
    const filterButtons = document.querySelectorAll<HTMLElement>('.filter-btn');
    const productLinks = document.querySelectorAll<HTMLElement>('#grid > a');

    filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
            const category = btn.dataset.category;

            filterButtons.forEach((b) => b.classList.remove('active'));
            btn.classList.add('active');

            productLinks.forEach((link) => {
                const passt = category === 'all' || link.dataset.category === category;
                link.style.display = passt ? '' : 'none';
            });
        });
    });

</script>